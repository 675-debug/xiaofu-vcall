  <property name="styleSheet">
   <string notr="true">#ChatWidget{background:#FFFFFF;font-family:"Microsoft YaHei UI";}
#titleBar{background:#FFFFFF;border-bottom:1px solid #E8E8ED;}
#titleLabel{font-size:13px;font-weight:600;color:#48484A;}
QToolButton#btnMin,QToolButton#btnMax,QToolButton#btnClose{border:none;border-radius:8px;}
QToolButton#btnMin:hover,QToolButton#btnMax:hover{background:#F5F5F5;}
QToolButton#btnClose:hover{background:#FF5F57;}
QPushButton#btnBack{border:none;background:transparent;color:#007AFF;font-size:13px;font-weight:500;padding:4px 2px;}
QPushButton#btnBack:hover{color:#0062CC;}
#convListPanel{background:#FAFAFA;border-right:1px solid #E8E8ED;}
#labelConvTitle{font-size:15px;font-weight:700;color:#1A1A2E;padding:14px 16px 6px 16px;}
QListWidget#convList{border:none;background:transparent;outline:none;}
QListWidget#convList::item{padding:12px 16px;border-left:2px solid transparent;color:#1A1A2E;font-size:13px;}
QListWidget#convList::item:hover{background:#F5F5F5;}
QListWidget#convList::item:selected{background:#EBF5FF;border-left-color:#007AFF;color:#1A1A2E;}
#chatPanel{background:#FFFFFF;}
#chatHead{border-bottom:1px solid #F0F0F3;background:#FFFFFF;}
#headAvatar{border-radius:16px;background:#10B981;color:#FFFFFF;font-size:12px;font-weight:700;}
#headName{font-size:14px;font-weight:600;color:#1A1A2E;}
#headStatus{font-size:11px;color:#34C759;font-weight:500;}
QToolButton#btnCall{border:1px solid #E8E8ED;border-radius:10px;background:#F5F5F5;}
QToolButton#btnCall:hover{background:#E8E8ED;}
QListWidget#listMessages{border:none;background:#FAFAFA;}
QListWidget#listMessages::item{padding:0px;color:#1A1A2E;font-size:13px;}
#inputRow{background:#FFFFFF;border-top:1px solid #E8E8ED;}
QLineEdit#editMessage{border:1.5px solid #E8E8ED;border-radius:10px;padding:0 14px;font-size:13px;background:#FAFAFA;color:#1A1A2E;}
QLineEdit#editMessage:focus{border-color:#007AFF;background:#FFFFFF;}
QPushButton#btnSend{background:#007AFF;color:#FFFFFF;border:none;border-radius:10px;font-size:13px;font-weight:600;padding:0 22px;}
QPushButton#btnSend:hover{background:#0062CC;}
QPushButton#btnSend:pressed{background:#0051A8;}
QPushButton#btnSend:disabled{background:#A8CFFF;color:#F7FAFF;}</string>
  </property>
