  <property name="styleSheet">
   <string notr="true">#RegisterWidget{background:#FFFFFF;font-family:"Microsoft YaHei UI";}
#titleBar{background:#FFFFFF;border-bottom:1px solid #E8E8ED;}
#titleLabel{font-size:13px;font-weight:600;color:#48484A;}
#body{background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #FAFAFA,stop:1 #F0F0F3);}
QToolButton#btnMin,QToolButton#btnMax,QToolButton#btnClose{border:none;border-radius:8px;}
QToolButton#btnMin:hover,QToolButton#btnMax:hover{background:#F5F5F5;}
QToolButton#btnClose:hover{background:#FF5F57;}
#logoGlow{background:rgba(0,122,255,40);border-radius:20px;}
#logo{background:#007AFF;color:#FFFFFF;border-radius:16px;font-size:22px;font-weight:700;}
#title{font-size:22px;font-weight:700;color:#1A1A2E;}
#sub{font-size:13px;color:#8E8E93;}
QLineEdit{border:1.5px solid #E8E8ED;border-radius:10px;padding:0 14px 0 42px;font-size:14px;background:#FAFAFA;color:#1A1A2E;}
QLineEdit:focus{border-color:#007AFF;background:#FFFFFF;}
QLineEdit[error="true"]{border:1.5px solid #FF3B30;background:#FFF5F5;}

QPushButton#btnRegister{background:#007AFF;color:#FFFFFF;border:none;border-radius:10px;font-size:15px;font-weight:600;}
QPushButton#btnRegister:hover{background:#0062CC;}
QPushButton#btnRegister:pressed{background:#0051A8;}
QPushButton#btnRegister:disabled{background:#A8CFFF;color:#F7FAFF;}
QPushButton#btnBackLogin{border:none;background:transparent;color:#007AFF;font-size:13px;font-weight:500;padding:4px 2px;}
QPushButton#btnBackLogin:hover{color:#0062CC;}</string>
