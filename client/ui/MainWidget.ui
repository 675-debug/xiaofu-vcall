  </property>
  <property name="styleSheet">
   <string notr="true">#MainWidget{background:#FFFFFF;font-family:&quot;Microsoft YaHei UI&quot;;}
#titleBar{background:#FFFFFF;border-bottom:1px solid #E8E8ED;}
#titleLabel{font-size:13px;font-weight:600;color:#48484A;}
QToolButton#btnMin,QToolButton#btnMax,QToolButton#btnClose{border:none;border-radius:8px;color:#8E8E93;font-size:15px;}
QToolButton#btnMin:hover,QToolButton#btnMax:hover{background:#F5F5F5;color:#48484A;}
QToolButton#btnClose:hover{background:#FF5F57;color:#FFFFFF;}
#sidebar{background:#FAFAFA;border-right:1px solid #E8E8ED;}
#toolbar{background:#FFFFFF;border-bottom:1px solid #E8E8ED;}
QToolButton#btnAvatar{border:none;border-radius:20px;background:#007AFF;color:#FFFFFF;font-size:16px;font-weight:700;}
QToolButton#btnAvatar:hover{background:#0062CC;}
#labelMyName{font-size:14px;font-weight:600;color:#1A1A2E;}
#labelMyStatus{font-size:11px;color:#34C759;font-weight:500;}
#myAccountInfo{background:#F5F5F5;border-radius:12px;}
#myAccountInfo:hover{background:#E8E8ED;}
QLineEdit#editSearch{border:1px solid #D9D9DE;border-radius:10px;padding:0 12px;font-size:13px;background:#F5F5F5;color:#1A1A2E;}
QLineEdit#editSearch:focus{border-color:#007AFF;background:#FFFFFF;}
QToolButton#btnSettings,QToolButton#btnAddContact{border:1px solid #E8E8ED;border-radius:10px;background:#F5F5F5;color:#48484A;font-size:13px;font-weight:500;padding:0 10px;}
QToolButton#btnSettings:hover,QToolButton#btnAddContact:hover{background:#E8E8ED;}
#labelOnline,#labelOffline{font-size:11px;font-weight:700;color:#6E6E73;padding:8px 16px 4px 16px;}
QListWidget#listContacts,QListWidget#listOffline{border:none;background:transparent;outline:none;padding:0 12px 8px 12px;}
QListWidget#listContacts::item,QListWidget#listOffline::item{padding:0px;border-radius:10px;color:#1A1A2E;font-size:13px;}
QListWidget#listContacts::item:hover,QListWidget#listOffline::item:hover{background:#F0F0F3;}
QListWidget#listContacts::item:selected,QListWidget#listOffline::item:selected{background:#E8F1FF;color:#1A1A2E;}
#detailPanel{background:#FFFFFF;}
#labelChatEmpty{font-size:14px;color:#AEAEB2;}
#chatAvatar{border-radius:21px;background:#10B981;color:#FFFFFF;font-size:15px;font-weight:700;}
#chatName{font-size:15px;font-weight:700;color:#1A1A2E;}
#chatStatus{font-size:11px;color:#34C759;font-weight:500;}
QToolButton#btnCall{border:1px solid #E8E8ED;border-radius:10px;background:#F5F5F5;color:#48484A;font-size:13px;font-weight:500;padding:0 14px;}
QToolButton#btnCall:hover{background:#E8E8ED;}
QListWidget#listMessages{border:none;background:#FFFFFF;}
QListWidget#listMessages::item{padding:0px;color:#1A1A2E;font-size:13px;}
#inputRow{background:#FAFAFA;border-top:1px solid #F0F0F3;}
QLineEdit#editMessage{border:1px solid #D9D9DE;border-radius:10px;padding:0 14px;font-size:13px;background:#FAFAFA;color:#1A1A2E;}
QLineEdit#editMessage:focus{border-color:#007AFF;background:#FFFFFF;}
QPushButton#btnSend{background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #1A8CFF,stop:1 #007AFF);color:#FFFFFF;border:none;border-radius:12px;font-size:14px;font-weight:600;padding:0 24px;}
QPushButton#btnSend:hover{background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #1284FA,stop:1 #0062CC);}
QPushButton#btnSend:pressed{background:#0055B8;}
#settingsMask{background:rgba(0,0,0,60);}
#settingsPanel{background:#FFFFFF;border-radius:14px;}
#labelSettingsTitle{font-size:16px;font-weight:700;color:#1A1A2E;}
#rowAccount,#rowNick,#rowStatus,#rowQuality,#rowRecordDir,#rowVersion{border-bottom:1px solid #F0F0F3;}
#labelAccountKey,#labelNickKey,#labelStatusKey,#labelQualityKey,#labelRecordDirKey,#labelVersionKey{font-size:13px;color:#48484A;}
#labelSettingAccount,#labelSettingNick,#labelSettingQuality,#labelSettingVersion{font-size:13px;color:#8E8E93;}
#labelSettingStatus{font-size:13px;color:#34C759;}
QPushButton#btnLogout,QPushButton#btnCloseModal{border:1px solid #E8E8ED;border-radius:10px;background:#F5F5F5;color:#48484A;font-size:13px;font-weight:500;}
#editRecordDir{border:1px solid #E8E8ED;border-radius:8px;background:#F5F5F5;color:#48484A;font-size:12px;padding:0 8px;}
QPushButton#btnChooseRecordDir{border:1px solid #E8E8ED;border-radius:8px;background:#F5F5F5;color:#48484A;font-size:12px;font-weight:500;padding:0 14px;}
QPushButton#btnChooseRecordDir:hover{background:#E8E8ED;}
QPushButton#btnLogout:hover,QPushButton#btnCloseModal:hover{background:#E8E8ED;}
QPushButton#btnClearChatRecords{border:1px solid #FFB7B2;border-radius:10px;background:#FFF5F4;color:#D92D20;font-size:13px;font-weight:600;}
QPushButton#btnClearChatRecords:hover{background:#FFE7E5;}</string>
