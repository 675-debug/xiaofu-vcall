  <property name="styleSheet">
   <string notr="true">QWidget#CallWidget,QWidget#callPage{background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #1A1A2E,stop:1 #2C2C2E);font-family:"Microsoft YaHei UI";}
#titleBar{background:rgba(0,0,0,46);}
#titleLabel{font-size:13px;font-weight:600;color:rgba(255,255,255,191);}
QToolButton#btnMin,QToolButton#btnMax,QToolButton#btnClose{border:none;border-radius:8px;}
QToolButton#btnMin:hover,QToolButton#btnMax:hover{background:rgba(255,255,255,31);}
QToolButton#btnClose:hover{background:#FF5F57;}
#statusPill{background:rgba(255,255,255,26);border-radius:999px;color:#FFFFFF;font-size:12px;font-weight:500;padding:7px 14px;}
#avatarRinging{background:#10B981;color:#FFFFFF;font-weight:700;border-radius:55px;font-size:42px;}
#avatarIncall{background:#10B981;color:#FFFFFF;font-weight:700;border-radius:65px;font-size:48px;}
#nameRinging,#nameIncall{color:#FFFFFF;font-size:20px;font-weight:600;}
#hintRinging{color:rgba(255,255,255,128);font-size:12px;}
QPushButton#btnCancelCall{background:rgba(255,255,255,36);color:#FFFFFF;border:none;border-radius:999px;font-size:14px;font-weight:600;padding:12px 26px;}
QPushButton#btnCancelCall:hover{background:rgba(255,255,255,66);}
QPushButton#btnPip{background:#3A3A3C;color:rgba(255,255,255,153);border:1.5px solid rgba(255,255,255,64);border-radius:14px;font-size:12px;}
QPushButton#btnPip:hover{background:#4A4A4C;}
#statusIncall{color:rgba(255,255,255,128);font-size:12px;}
QPushButton#btnMic,QPushButton#btnCam,QPushButton#btnMore{background:rgba(255,255,255,36);color:#FFFFFF;border:none;border-radius:28px;font-size:12px;}
QPushButton#btnMic:hover,QPushButton#btnCam:hover,QPushButton#btnMore:hover{background:rgba(255,255,255,66);}
QPushButton#btnMic[active="false"],QPushButton#btnCam[active="false"]{background:#FFFFFF;color:#1A1A2E;}
QPushButton#btnMore[active="true"]{background:rgba(255,255,255,82);}
QPushButton#btnHangup{background:#FF3B30;color:#FFFFFF;border:none;border-radius:32px;font-size:13px;font-weight:600;}
QPushButton#btnHangup:hover{background:#E0352B;}
#moreMenu{background:#FFFFFF;border-radius:12px;}
QPushButton#btnShare,QPushButton#btnRecord,QPushButton#btnSpeaker,QPushButton#btnFullscreen{border:none;background:transparent;color:#1A1A2E;font-size:13px;border-radius:8px;padding:9px 12px;text-align:left;}
QPushButton#btnShare:hover,QPushButton#btnRecord:hover,QPushButton#btnSpeaker:hover,QPushButton#btnFullscreen:hover{background:#F5F5F5;}
QPushButton[active="true"]#btnShare,QPushButton[active="true"]#btnRecord,QPushButton[active="true"]#btnSpeaker{background:#E8F1FF;color:#007AFF;font-weight:600;}</string>
