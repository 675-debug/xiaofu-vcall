*.a

# Local data and logs
db/*.db
*.log
stderr*.txt

# IDE / editor settings
.idea/
.vscode/
.superpowers/
client/.qtc_clangd/
*.user

# Local UI backups and verification screenshots
client/ui/backup-*/
client/ui/_*.png
client/ui/*.bak-session-artifact
docs/tmp-ui-specs/

# Local design assets and planning notes not published to this repository
/UI/
/docs/
!/docs/
/docs/*
!/docs/video-call-technical-plan.md
/mermaid-diagram*.svg
/*.md
!README.md
/LICENSE

# Local packaged release output (never publish)
dist/

# Linux launcher with real TURN credential (never publish)
client/start_video_call.sh

# Runtime configuration with deployment-specific values (templates stay tracked)
client/config.ini
server/xiaofu_server/deploy/xiaofu-server.env
server/FunASR_Server/deploy/funasr-server.env

# Local backup files
*.bak*

# FunASR 推理服务（腾讯云）：模型/日志/venv 不入库，保留目录占位
server/FunASR_Server/model/*
!server/FunASR_Server/model/.gitkeep
server/FunASR_Server/logs/*
!server/FunASR_Server/logs/.gitkeep
server/FunASR_Server/venv/
# xiaofu_server 本地运行数据目录（当前数据库实现为 MySQL）
server/xiaofu_server/data/

# Python 字节码缓存
__pycache__/

# SQLite WAL 运行文件（全局兜底）
*.db-wal
*.db-shm
